# Provedor de IA: claude (Claude API) ou lmstudio (modelo local via LM Studio)
PROVEDOR_IA=claude

# --- Claude API ---
# Chave em https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Modelo usado na extração (troque para os experimentos: claude-sonnet-5-5, claude-haiku-4-5)
MODELO_CLAUDE=claude-opus-5-5

# --- LM Studio (modelo local) ---
LMSTUDIO_URL=http://localhost:1234/v1
# Identificador do modelo como aparece no LM Studio; vazio = primeiro modelo disponível
LMSTUDIO_MODELO=
# Tempo máximo de espera em segundos (modelos locais em CPU são lentos)
LMSTUDIO_TIMEOUT=600

# Banco de dados (SQLite local por padrão; ex. PostgreSQL: postgresql+psycopg://user:senha@localhost/primefiscal)
DATABASE_URL=sqlite:///./primefiscal.db

# Origens permitidas para o frontend (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173

# Tamanho máximo do PDF em MB
TAMANHO_MAXIMO_MB=20
