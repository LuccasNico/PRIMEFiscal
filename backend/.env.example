# ============================================================
#  Provedor de IA usado na extração
# ============================================================
# gemini     -> Google Gemini API (padrão; "google" também é aceito)
# claude     -> Claude API (Anthropic)
# lmstudio   -> modelo local rodando no LM Studio
# compativel -> qualquer API no padrão da OpenAI (OpenAI, Groq, OpenRouter, Ollama...)
# Só o bloco do provedor escolhido precisa estar preenchido.
PROVEDOR_IA=gemini

# --- Google Gemini ---
# Chave em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Outros: gemini-3.8-flash (mais recente), gemini-3.1-flash-lite (mais rápido)
GEMINI_MODELO=gemini-3.5-flash
# Tempo máximo de espera pela resposta, em segundos
GEMINI_TIMEOUT=120

# --- Claude API (opcional) ---
# Chave em https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Outros modelos para comparação: claude-sonnet-5-5, claude-haiku-5-5
MODELO_CLAUDE=claude-opus-5-5

# --- LM Studio (opcional) ---
LMSTUDIO_URL=http://127.0.0.1:1234/v1
# Nome do modelo como aparece no LM Studio; vazio = primeiro modelo disponível
LMSTUDIO_MODELO=
# Modelos locais rodando na CPU são lentos, por isso o tempo de espera é maior
LMSTUDIO_TIMEOUT=600

# --- API compatível com OpenAI (opcional) ---
# Nome mostrado na interface e nas mensagens de erro
API_COMPATIVEL_NOME=OpenAI
# Endereço base, terminando em /v1. Exemplos:
#   OpenAI      https://api.openai.com/v1
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Ollama      http://127.0.0.1:11434/v1
API_COMPATIVEL_URL=https://api.openai.com/v1
API_COMPATIVEL_CHAVE=
API_COMPATIVEL_MODELO=gpt-4o-mini
API_COMPATIVEL_TIMEOUT=120
# Como pedir o JSON: json_schema (mais confiável), json_object ou prompt.
# Use json_object ou prompt se o serviço recusar o json_schema.
API_COMPATIVEL_FORMATO_RESPOSTA=json_schema

# ============================================================
#  Servidor
# ============================================================
# Banco de dados. Vazio = SQLite em backend/primefiscal.db
# PostgreSQL (local ou na nuvem): cole a URL fornecida pelo serviço; postgres:// também é aceito.
# Antes do primeiro uso, rode banco/criar_banco.sql nesse banco (veja o README).
#   postgresql://usuario:senha@servidor:5432/primefiscal?sslmode=require
DATABASE_URL=
# Pasta dos PDFs enviados. Vazio = backend/uploads
PASTA_UPLOADS=
# Endereços que podem acessar a API (separados por vírgula). No deploy: a URL do frontend,
# ex.: https://primefiscal.onrender.com
CORS_ORIGINS=http://localhost:5173
# Tamanho máximo de cada PDF, em MB
TAMANHO_MAXIMO_MB=20
