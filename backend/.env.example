# Provedor de IA: claude, gemini (ou google), lmstudio (modelo local) ou compativel (API OpenAI-compatible)
PROVEDOR_IA=claude

# --- Claude API ---
# Chave em https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Modelo usado na extração (troque para os experimentos: claude-sonnet-5-5, claude-haiku-5-5)
MODELO_CLAUDE=claude-opus-5-5

# --- LM Studio (modelo local) ---
LMSTUDIO_URL=http://127.0.0.1:1234/v1
# Identificador do modelo como aparece no LM Studio; vazio = primeiro modelo disponível
LMSTUDIO_MODELO=
# Tempo máximo de espera em segundos (modelos locais em CPU são lentos)
LMSTUDIO_TIMEOUT=600

# --- APIs compatíveis com OpenAI ---
# OpenAI: https://api.openai.com/v1 | Ollama: http://127.0.0.1:11434/v1
# Groq, OpenRouter, Together, vLLM e outros também funcionam se expuserem /chat/completions.
# Configure PROVEDOR_IA=compativel para ativar.
API_COMPATIVEL_URL=https://api.openai.com/v1
API_COMPATIVEL_CHAVE=
API_COMPATIVEL_MODELO=gpt-4o-mini
API_COMPATIVEL_NOME=OpenAI
API_COMPATIVEL_TIMEOUT=120
# json_schema é o mais seguro; use json_object ou prompt se seu serviço não o suportar.
API_COMPATIVEL_FORMATO_RESPOSTA=json_schema

# --- Google Gemini ---
# Chave em https://aistudio.google.com/app/apikey. Configure PROVEDOR_IA=gemini.
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash
GEMINI_TIMEOUT=120

# Banco de dados. Sem esta variável, usa o SQLite em backend/primefiscal.db.
# Ex. PostgreSQL: postgresql+psycopg://user:senha@localhost/primefiscal
# DATABASE_URL=

# Pasta onde os PDFs enviados ficam guardados. Sem esta variável, usa backend/uploads.
# PASTA_UPLOADS=

# Origens permitidas para o frontend (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173

# Tamanho máximo do PDF em MB
TAMANHO_MAXIMO_MB=20
